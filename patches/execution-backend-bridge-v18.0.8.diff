+
+interface WireRegister { readonly type: "register"; readonly address: string; }
+interface WireUnregister { readonly type: "unregister"; readonly address: string; }
+interface WireSend { readonly type: "send"; readonly envelope: unknown; }
+interface WireAck { readonly type: "ack"; readonly messageId: string; }
+interface WireDelivery { readonly type: "delivery"; readonly envelope: unknown; }
+interface WireAccepted { readonly type: "accepted"; readonly messageId: string; }
