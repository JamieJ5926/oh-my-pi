+
+export class PiRpcBackend {
+	readonly #options: PiResolvedBackendOptions;
+	constructor(options: PiBackendOptions = {}) { this.#options = { ...options, command: options.command ?? DEFAULT_PI_COMMAND, maxEventBuffer: positiveInteger(options.maxEventBuffer, DEFAULT_EVENT_BUFFER), cancelTimeoutMs: positiveInteger(options.cancelTimeoutMs, 5000) }; }
+	async start(request: PiBackendRequest = {}): Promise<PiExecutionSession> {
+		const args = [this.#options.command, ...(this.#options.args ?? []), "--mode", "rpc"];
+		if (this.#options.sessionDir) args.push("--session-dir", this.#options.sessionDir);
+		if (request.sessionFile) args.push("--session", request.sessionFile);
+		if (request.sessionId) args.push("--session-id", request.sessionId);
