+  const next = prior.catch(() => undefined).then(operation);
+  journalOperations.set(file, next);
+  void next.then(
+    () => { if (journalOperations.get(file) === next) journalOperations.delete(file); },
+    () => { if (journalOperations.get(file) === next) journalOperations.delete(file); },
+  );
+  return next;
+}
+
+function enqueueJournalCompaction(file: string, entries: readonly JournalEntry[], removedIds: Set<string>): Promise<void> {
