+		if (request.model) args.push("--model", request.model);
+		const spawn = this.#options.spawn ?? ((command, options) => Bun.spawn([...command], { cwd: options.cwd, env: options.env, stdin: "pipe", stdout: "pipe", stderr: "pipe" }));
