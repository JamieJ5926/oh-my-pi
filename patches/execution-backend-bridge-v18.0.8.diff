+import { DEFAULT_EVENT_BUFFER, DEFAULT_PI_COMMAND, abortError, createAsyncQueue, onceAbort, positiveInteger } from "./helpers";
+import { type PiRequestId, type PiRpcCommand, type PiRpcEvent, encodePiCommand, parsePiFrame } from "./protocol";
+
+export interface PiModelAttribution { readonly requestedProvider?: string; readonly requestedModel?: string; readonly resolvedProvider?: string; readonly resolvedModel?: string; readonly fallback: "yes" | "no" | "unknown" }
+export interface PiUsage { readonly input?: number; readonly output?: number; readonly total?: number; readonly cost?: number }
+export interface PiExecutionEvent { readonly sequence: number; readonly receivedAt: number; readonly event: PiRpcEvent; readonly model: PiModelAttribution; readonly usage?: PiUsage }
+export interface PiTerminalResult { readonly ok: boolean; readonly sessionId: string; readonly stopReason?: string; readonly text: string; readonly usage?: PiUsage; readonly model: PiModelAttribution; readonly error?: string }
+export interface PiExecutionSession { readonly sessionId: string; readonly sessionFile?: string; readonly events: AsyncIterable<PiExecutionEvent>; prompt(message: string, signal?: AbortSignal): Promise<PiTerminalResult>; steer(message: string): Promise<void>; followUp(message: string): Promise<void>; setModel(provider: string, modelId: string): Promise<void>; cancel(reason?: string): Promise<void>; resume(): Promise<PiExecutionSession>; dispose(): Promise<void> }
+export interface PiBackendRequest { readonly prompt?: string; readonly sessionId?: string; readonly sessionFile?: string; readonly provider?: string; readonly model?: string; readonly cwd?: string; readonly signal?: AbortSignal }
+export interface PiRpcProcess { readonly stdin: { write(data: string): unknown }; readonly stdout: ReadableStream<Uint8Array>; readonly exited: Promise<number>; kill(): void }
+export interface PiBackendOptions { readonly command?: string; readonly args?: readonly string[]; readonly cwd?: string; readonly env?: Record<string, string | undefined>; readonly sessionDir?: string; readonly maxEventBuffer?: number; readonly cancelTimeoutMs?: number; readonly spawn?: (command: readonly string[], options: { cwd?: string; env?: Record<string, string | undefined> }) => PiRpcProcess }
+interface PiResolvedBackendOptions { readonly command: string; readonly maxEventBuffer: number; readonly cancelTimeoutMs: number; readonly args?: readonly string[]; readonly cwd?: string; readonly env?: Record<string, string | undefined>; readonly sessionDir?: string; readonly spawn?: PiBackendOptions["spawn"] }
+interface PendingResponse { readonly resolve: (response: ResponseFrame) => void; readonly reject: (error: Error) => void }
+interface ResponseFrame { readonly success: boolean; readonly data?: unknown }
+
+function isRecord(value: unknown): value is Record<string, unknown> { return typeof value === "object" && value !== null && !Array.isArray(value) }
+function record(value: unknown): Record<string, unknown> | undefined { return isRecord(value) ? value : undefined }
+function stringValue(value: unknown, ...keys: string[]): string | undefined { const source = record(value); if (!source) return undefined; for (const key of keys) if (typeof source[key] === "string") return source[key]; return undefined }
+function numberValue(value: unknown, ...keys: string[]): number | undefined { const source = record(value); if (!source) return undefined; for (const key of keys) if (typeof source[key] === "number" && Number.isFinite(source[key])) return source[key]; return undefined }
+function nestedSources(event: PiRpcEvent): Record<string, unknown>[] { const source = record(event); if (!source) return []; const message = record(source.message); const assistantMessageEvent = record(source.assistantMessageEvent); return [source, ...(message ? [message] : []), ...(assistantMessageEvent ? [assistantMessageEvent] : [])] }
+function firstString(sources: Record<string, unknown>[], ...keys: string[]): string | undefined { for (const source of sources) { const value = stringValue(source, ...keys); if (value !== undefined) return value } return undefined }
+function modelFrom(event: PiRpcEvent, requestedProvider?: string, requestedModel?: string, previous?: PiModelAttribution): PiModelAttribution { const sources = nestedSources(event); const resolvedProvider = firstString(sources, "provider", "resolvedProvider") ?? previous?.resolvedProvider; const resolvedModel = firstString(sources, "model", "modelId", "resolvedModel") ?? previous?.resolvedModel; const fallback = resolvedProvider && resolvedModel ? resolvedProvider !== requestedProvider || resolvedModel !== requestedModel ? "yes" : "no" : "unknown"; return { requestedProvider, requestedModel, resolvedProvider, resolvedModel, fallback } }
+function usageFrom(event: PiRpcEvent): PiUsage | undefined { const sources = nestedSources(event); const usage = record(record(event)?.usage); const usageSources = usage ? [usage, ...sources] : sources; const input = usageSources.map(source => numberValue(source, "input", "inputTokens", "input_tokens")).find(value => value !== undefined); const output = usageSources.map(source => numberValue(source, "output", "outputTokens", "output_tokens")).find(value => value !== undefined); const total = usageSources.map(source => numberValue(source, "total", "totalTokens", "total_tokens")).find(value => value !== undefined); const cost = usageSources.map(source => numberValue(source, "cost", "totalCost")).find(value => value !== undefined); return input === undefined && output === undefined && total === undefined && cost === undefined ? undefined : { input, output, total, cost } }
