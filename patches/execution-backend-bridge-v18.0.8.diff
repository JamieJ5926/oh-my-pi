+		const session = {
+			cwd: "/tmp",
+			hasUI: false,
+			settings: Settings.isolated({
+				"task.maxRecursionDepth": 2,
+				"task.isolation.mode": "none",
+				roleProfiles: {
+					leaf: {
+						agents: ["worker"],
+						tools: ["read"],
+						model_role: "explorer",
+						minimalPrompt: true,
+						softRequestBudget: 4,
+					} satisfies RoleProfileConfig,
+				},
+			}),
+			getSessionFile: () => null,
+			getSessionSpawns: () => "*",
+		} as unknown as ToolSession;
+		const policy = await resolveEffectiveSubagentPolicy({
+			session,
+			invocationKind: "task",
+			assignment: "x",
+			agent: "worker",
+		});
+		expect(policy.executionBackend).toBe("local");
+	});
+
+	it("selects jcode from a configured role profile", async () => {
+		vi.spyOn(discoveryModule, "discoverAgents").mockResolvedValue({ agents: [worker], projectAgentsDir: null });
+		const session = {
+			cwd: "/tmp",
+			hasUI: false,
+			settings: Settings.isolated({
+				"task.maxRecursionDepth": 2,
+				"task.isolation.mode": "none",
+				roleProfiles: {
+					leaf: {
+						agents: ["worker"],
+						tools: ["read"],
+						model_role: "explorer",
+						minimalPrompt: true,
+						softRequestBudget: 4,
+						execution_backend: "jcode",
+						jcode_provider_profile: "qwen-local",
+					} satisfies RoleProfileConfig,
+				},
+			}),
+			getSessionFile: () => null,
+			getSessionSpawns: () => "*",
+		} as unknown as ToolSession;
+		const policy = await resolveEffectiveSubagentPolicy({
+			session,
+			invocationKind: "task",
+			assignment: "x",
+			agent: "worker",
+		});
+		expect(policy.executionBackend).toBe("jcode");
+		expect(policy.jcodeProviderProfile).toBe("qwen-local");
+	});
+});
