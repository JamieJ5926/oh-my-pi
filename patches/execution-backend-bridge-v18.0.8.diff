+		if (request.prompt) void session.prompt(request.prompt, request.signal);
+		return session;
+	}
+}
+
+class PiRpcExecutionSession implements PiExecutionSession {
+	readonly #process: PiRpcProcess; readonly #args: readonly string[]; readonly #request: PiBackendRequest; readonly #options: PiResolvedBackendOptions; readonly #queue: ReturnType<typeof createAsyncQueue<PiExecutionEvent>>; readonly #pending = new Map<PiRequestId, PendingResponse>(); readonly #terminal: Promise<PiTerminalResult>; readonly #resolveTerminal: (result: PiTerminalResult) => void; readonly #rejectTerminal: (error: Error) => void;
