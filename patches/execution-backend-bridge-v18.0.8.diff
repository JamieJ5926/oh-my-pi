+	async waitFor(predicate: (requests: readonly HarnessRequest[]) => boolean): Promise<void> {
+		for (;;) {
+			if (predicate(this.requests)) return;
+			const { promise, resolve } = Promise.withResolvers<void>();
+			this.#requestWaiters.push(resolve);
+			await promise;
+		}
+	}
