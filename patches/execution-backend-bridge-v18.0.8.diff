+    "maxQueueBytes",
+    "maxJournalBytes",
+    "maxAttempts",
+    "retryBaseMs",
+    "retryMaxMs",
+  ] as const) {
+    if (!Number.isSafeInteger(value[key]) || value[key] <= 0) value[key] = DEFAULT_LIMITS[key];
+  }
+  if (value.retryMaxMs < value.retryBaseMs) value.retryMaxMs = value.retryBaseMs;
