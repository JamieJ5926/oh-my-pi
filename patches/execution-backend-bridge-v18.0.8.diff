+    constructor(process: PiRpcProcess, args: readonly string[], request: PiBackendRequest, options: PiResolvedBackendOptions) { this.#process = process; this.#args = args; this.#request = request; this.#options = options; this.#queue = createAsyncQueue(options.maxEventBuffer); this.#model = { requestedProvider: request.provider, requestedModel: request.model, fallback: "unknown" }; let resolveTerminal!: (result: PiTerminalResult) => void; let rejectTerminal!: (error: Error) => void; this.#terminal = new Promise<PiTerminalResult>((resolve, reject) => { resolveTerminal = resolve; rejectTerminal = reject }); this.#resolveTerminal = resolveTerminal; this.#rejectTerminal = rejectTerminal; void this.#readOutput() }
+	get events(): AsyncIterable<PiExecutionEvent> { return this.#queue.values }
+	get sessionId(): string { return this.#sessionId || this.#request.sessionId || "unknown" }
+	get sessionFile(): string | undefined { return this.#sessionFile }
+	async prompt(message: string, signal?: AbortSignal): Promise<PiTerminalResult> { if (this.#disposed) throw new Error("Pi session is disposed"); const removeAbort = onceAbort(signal, () => { void this.cancel("aborted") }); try { await this.#send({ type: "prompt", message, id: this.#nextId() }); return await this.#terminal } finally { removeAbort() } }
+	async steer(message: string): Promise<void> { await this.#send({ type: "steer", message, id: this.#nextId() }) }
+	async followUp(message: string): Promise<void> { await this.#send({ type: "follow_up", message, id: this.#nextId() }) }
+	async setModel(provider: string, modelId: string): Promise<void> { await this.#send({ type: "set_model", provider, modelId, id: this.#nextId() }) }
+	async cancel(reason?: string): Promise<void> { if (this.#disposed) return; try { await this.#send({ type: "abort", id: this.#nextId() }) } catch {} await Promise.race([this.#terminal.catch(() => undefined), new Promise<void>(resolve => setTimeout(resolve, this.#options.cancelTimeoutMs))]); if (!this.#settled) this.#finish({ ok: false, sessionId: this.sessionId, text: this.#text, usage: this.#usage, model: this.#model, stopReason: "aborted", error: reason ?? "aborted" }) }
+	async resume(): Promise<PiExecutionSession> { const sessionId = this.sessionId; const sessionFile = this.#sessionFile; await this.dispose(); const backend = new PiRpcBackend({ ...this.#options, args: this.#args.slice(1, this.#args.indexOf("--mode")) }); return backend.start({ ...this.#request, sessionId, sessionFile }) }
+	async dispose(): Promise<void> { if (this.#disposed) return; this.#disposed = true; for (const pending of this.#pending.values()) pending.reject(new Error("Pi process disposed")); this.#pending.clear(); this.#queue.close(); this.#process.kill(); await this.#process.exited }
+	async #send(command: PiRpcCommand): Promise<ResponseFrame> { if (this.#disposed) throw new Error("Pi session is disposed"); const id = command.id; if (id === undefined) throw new Error("Pi lifecycle commands require request ids"); const response = new Promise<ResponseFrame>((resolve, reject) => this.#pending.set(id, { resolve, reject })); try { this.#process.stdin.write(encodePiCommand(command)) } catch (error) { this.#pending.delete(id); throw abortError(error) } return response }
+	#nextId(): number { this.#requestId += 1; return this.#requestId }
+	#finish(result: PiTerminalResult): void { if (this.#settled) return; this.#settled = true; this.#resolveTerminal(result) }
+	async #readOutput(): Promise<void> { try { const reader = this.#process.stdout.getReader(); const decoder = new TextDecoder(); let buffer = ""; while (!this.#disposed) { const next = await reader.read(); if (next.done) break; buffer += decoder.decode(next.value, { stream: true }); const lines = buffer.split("\n"); buffer = lines.pop() ?? ""; for (const line of lines) { if (!line.trim()) continue; const event = parsePiFrame(line); if (event.type === "response" && event.id !== undefined) { const pending = this.#pending.get(event.id); if (pending) { this.#pending.delete(event.id); event.success ? pending.resolve({ success: true, data: event.data }) : pending.reject(new Error(event.error ?? `Pi ${event.command} failed`)) } continue } if (event.type === "session") { this.#sessionId = event.id; this.#sessionFile = event.sessionFile } this.#model = modelFrom(event, this.#request.provider, this.#request.model, this.#model); this.#usage = usageFrom(event) ?? this.#usage; if (event.type === "message_update") this.#text += textFrom(event); const normalized: PiExecutionEvent = { sequence: ++this.#sequence, receivedAt: Date.now(), event, model: this.#model, usage: this.#usage }; this.#queue.push(normalized); if (event.type === "agent_end") this.#finish({ ok: true, sessionId: this.sessionId, stopReason: stringValue(event, "stopReason", "stop_reason"), text: this.#text, usage: this.#usage, model: this.#model }) } } this.#queue.close(); if (!this.#settled && !this.#disposed) this.#rejectTerminal(new Error("Pi process ended before agent_end")) } catch (error) { this.#queue.close(abortError(error)); if (!this.#settled) this.#rejectTerminal(abortError(error)) } }
+}
+
+export function createPiBackend(options: PiBackendOptions = {}): PiRpcBackend { return new PiRpcBackend(options) }
diff --git a/packages/coding-agent/src/bridge/backends/pi/helpers.ts b/packages/coding-agent/src/bridge/backends/pi/helpers.ts
