+export function findRoleProfile(
+	profiles: Record<string, RoleProfileConfig> | undefined,
+	agentName: string,
+): RoleProfileConfig | undefined {
+	if (!profiles) return undefined;
+	for (const profile of Object.values(profiles)) {
